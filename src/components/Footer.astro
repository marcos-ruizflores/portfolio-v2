---
import type { Lang } from '../i18n/content';
import { v2 } from '../i18n/v2';
import { links } from '../data/profile';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = v2[lang];
const home = url(lang === 'en' ? '/' : '/es/');
---

<footer id="contact" class="bg-paper px-6 pb-8 pt-24 text-paper-ink sm:px-12">
  <a href={`mailto:${links.email}`} class="display block break-all text-[clamp(2rem,5.5vw,4.75rem)] hover:opacity-70 sm:break-normal">
    {links.email}
  </a>
  <div class="mt-6 flex flex-wrap gap-3">
    <a href={`mailto:${links.email}`} class="rounded-full bg-paper-ink px-5 py-2.5 text-sm text-paper transition-opacity hover:opacity-80">{t.sayHi}</a>
    <a href={links.cv} download class="rounded-full border border-paper-ink/20 px-5 py-2.5 text-sm transition-colors hover:border-paper-ink">{t.cv}</a>
  </div>

  <div class="mt-24 grid gap-12 border-t border-paper-ink/10 pt-12 md:grid-cols-[1fr_auto]">
    <div>
      <p class="display text-2xl">marcos ruiz-flores</p>
      <p class="display text-2xl text-paper-ink/45">{t.footerRole}</p>
    </div>
    <div class="grid grid-cols-3 gap-10 text-sm sm:gap-16">
      <div>
        <p class="text-xs text-paper-ink/45">{t.basedIn}</p>
        <p class="mt-3">Barcelona</p>
        <p class="text-paper-ink/45">{t.country}</p>
      </div>
      <div>
        <p class="text-xs text-paper-ink/45">{t.navigation}</p>
        <ul class="mt-3 space-y-1.5">
          <li><a href={home} class="hover:opacity-60">{t.home}</a></li>
          <li><a href="#work" class="hover:opacity-60">{t.work}</a></li>
          <li><a href="#experience" class="hover:opacity-60">{t.experience}</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs text-paper-ink/45">{t.elsewhere}</p>
        <ul class="mt-3 space-y-1.5">
          <li><a href={links.github} target="_blank" rel="noopener noreferrer" class="hover:opacity-60">GitHub</a></li>
          <li><a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="hover:opacity-60">LinkedIn</a></li>
          <li><a href={links.cv} download class="hover:opacity-60">CV</a></li>
        </ul>
      </div>
    </div>
  </div>

  <p class="mt-20 text-right text-xs text-paper-ink/45">© {new Date().getFullYear()} Marcos Ruiz-Flores</p>
</footer>
