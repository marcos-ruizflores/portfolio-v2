---
import type { Lang } from '../i18n/content';
import { v2 } from '../i18n/v2';
import { links } from '../data/profile';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = v2[lang];
---

<section class="relative h-svh min-h-[560px] overflow-hidden">
  {/* Flowing light ribbons drawn by a small WebGL shader; a CSS gradient stands in if WebGL is missing */}
  <canvas
    data-ribbons
    class="absolute inset-0 size-full bg-[radial-gradient(80%_60%_at_80%_20%,#3a3a44,transparent_70%)]"
    aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-bg to-transparent" aria-hidden="true"></div>

  {/* Minimal top bar */}
  <nav class="absolute inset-x-0 top-0 z-30 flex items-center justify-between px-6 py-5 text-sm mix-blend-difference sm:px-12">
    <a href={url(lang === 'en' ? '/' : '/es/')} class="font-medium tracking-tight">MR</a>
    <div class="flex items-center gap-5">
      <a href={url('/')} hreflang="en" class:list={[lang === 'en' ? 'opacity-100' : 'opacity-50 hover:opacity-100']}>EN</a>
      <a href={url('/es/')} hreflang="es" class:list={[lang === 'es' ? 'opacity-100' : 'opacity-50 hover:opacity-100']}>ES</a>
      <a href={links.cv} download class="opacity-80 hover:opacity-100">CV ↓</a>
    </div>
  </nav>

  <div class="relative flex h-full flex-col justify-center px-6 sm:px-12">
    <h1 class="display text-[clamp(2.75rem,7.2vw,7rem)]">
      <span class="rise block" style="--d: 100ms">{t.lines[0]}</span>
      <span class="rise block" style="--d: 220ms">{t.lines[1]}</span>
      <span class="rise block text-muted" style="--d: 340ms">
        <span class="sr-only">{t.rotating.join('. ')}</span>
        <span data-rotating={JSON.stringify(t.rotating)} aria-hidden="true">{t.rotating[0]}</span><span class="cursor" aria-hidden="true">_</span>
      </span>
    </h1>
  </div>
</section>

<script>
  // Third hero line: deletes and types through a few phrases
  const el = document.querySelector<HTMLElement>('[data-rotating]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce) {
    const phrases: string[] = JSON.parse(el.dataset.rotating ?? '[]');
    let i = 0;
    let n = phrases[0].length;
    let deleting = true;
    const tick = () => {
      n += deleting ? -1 : 1;
      el.textContent = phrases[i].slice(0, n);
      let wait = deleting ? 30 : 65;
      if (!deleting && n === phrases[i].length) {
        deleting = true;
        wait = 2400;
      } else if (deleting && n === 0) {
        deleting = false;
        i = (i + 1) % phrases.length;
        wait = 300;
      }
      setTimeout(tick, wait);
    };
    setTimeout(tick, 3000);
  }

  // Ribbon shader
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ribbons]');
  const gl = canvas?.getContext('webgl', { antialias: false, premultipliedAlpha: false });

  if (canvas && gl) {
    const vert = `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`;
    const frag = `
      precision highp float;
      uniform vec2 res;
      uniform float time;

      // Soft bright bands that bend along x and drift over time
      float ribbons(vec2 p) {
        float bend = sin(p.x * 1.6 + time * 0.20) * 0.30 + sin(p.x * 2.9 - time * 0.13) * 0.06;
        float y = p.y + bend - p.x * 0.55;
        float s = sin(y * 8.5 - time * 0.25);
        return pow(smoothstep(0.1, 1.0, s), 2.2);
      }

      void main() {
        vec2 uv = gl_FragCoord.xy / res;
        vec2 p = vec2(uv.x * res.x / res.y, uv.y) * 1.1;

        // Slight colour split for a lens-like edge
        float k = 0.006;
        vec3 c = vec3(ribbons(p + vec2(k, 0.0)), ribbons(p), ribbons(p - vec2(k, 0.0)));
        c *= vec3(0.9, 0.94, 1.04);

        // Fade towards the bottom-left so the type stays readable
        float mask = smoothstep(0.25, 1.1, uv.x * 0.75 + uv.y * 0.65);
        c *= mask * 1.15;

        // Very fine scanlines
        c *= 0.94 + 0.06 * sin(gl_FragCoord.y * 2.2);

        gl_FragColor = vec4(c + 0.039, 1.0);
      }`;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'res');
    const uTime = gl.getUniformLocation(prog, 'time');

    // Render at reduced resolution: it's a blurry effect anyway and saves battery
    const resize = () => {
      const scale = Math.min(window.devicePixelRatio, 1.5) * 0.6;
      canvas.width = Math.round(canvas.clientWidth * scale);
      canvas.height = Math.round(canvas.clientHeight * scale);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
    };
    resize();
    window.addEventListener('resize', resize);

    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    const start = performance.now();
    const draw = (now: number) => {
      gl.uniform1f(uTime, reduce ? 4 : (now - start) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduce) requestAnimationFrame(loop);
    };
    const loop = (now: number) => (visible ? draw(now) : requestAnimationFrame(loop));
    requestAnimationFrame(draw);
  }
</script>
